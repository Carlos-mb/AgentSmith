# Copy this file to .env and replace values locally. Never commit real keys.
PROVIDER_API_KEY=
PROVIDER_API_KEY_2=

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
MISTRAL_API_KEY=
# Export this path to use the provider-specific variables above.
AGENT_SMITH_MODELS_CONFIG=configs/models_template.json

# Optional diagnostics: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Empty or unset disables logging. DEBUG includes full AI, MCP and Docker exchanges.
AGENT_SMITH_LOG_LEVEL=
